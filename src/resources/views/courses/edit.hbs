

<div class="mt-4">
    <h3>Cập nhật khóa học</h3>
    <form class="mt-4" method="post" action="/courses/{{course._id}}?_method=PUT">
    <div class="mb-3">
        <label for="name" class="form-label">Tên</label>
        <input type="text" class="form-control" id="name" 
        name="name" value="{{course.name}}"     >
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Mô tả</label>
        <textarea  class="form-control" id="description" 
        name="description"  >{{course.description}}</textarea>
    </div>

    <div class="mb-3">
        <label for="videoid" class="form-label">VideoId</label>
        <input type="text" class="form-control" id="videoid" 
        name="videoId"  value="{{course.videoId}}"      >
    </div>

    <div class="mb-3">
        <label for="level" class="form-label">Trình độ</label>
        <input type="text" class="form-control" id="level" 
        name="level" value="{{course.level}}">
    </div>

    <button type="submit" class="btn-solid theme-primary">Lưu lại</button>
    </form>
</div>
